.venv/
__pycache__/
*.pyc
.mise.local.toml

# Configuración local: se copia de .env.example y cada uno ajusta la suya.
.env

# Estado local del taller: se regenera. La tabla cruda sale del Excel de la tesis (~40 s) y el caché
# de etapas se recalcula solo. El árbol de ejecuciones es exploración local, no registro canónico.
data/cache/
data/crudo.joblib
data/ejecuciones.sqlite

# Los documentos de la revisión experta y su historial de versiones. Son trabajo humano sobre
# telemetría del satélite: no se publican, igual que los datos crudos. Se respaldan copiando la
# carpeta de datos, que es donde vive todo el estado.
data/revision/

# Estado del Document Server de desarrollo: sus registros y las claves que se genera solo al
# arrancar (entre ellas una privada, que no tiene por qué andar en un repo). Es suyo, no nuestro, y
# se regenera con el contenedor. En el servidor esta carpeta ni siquiera existe: allá el Document
# Server es externo.
data/onlyoffice/

# Red de seguridad por si DIR_DATOS apunta a otra carpeta dentro del repo.
*.joblib
*.sqlite
*.xlsx

.pytest_cache/

# Skill de terceros instalado para explorar diseño; no es parte de la tesis.
.claude/
